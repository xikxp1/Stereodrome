{
  "name": "stereodrome-mobile",
  "private": true,
  "main": "index.ts",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "vp exec expo start --dev-client",
    "android": "vp exec expo run:android",
    "ios": "vp exec expo run:ios",
    "rust:ios": "../scripts/build-mobile-rust.sh ios",
    "rust:android": "../scripts/build-mobile-rust.sh android",
    "rust:mobile": "../scripts/build-mobile-rust.sh all",
    "rust:check": "../scripts/build-and-check-mobile-rust.sh all",
    "rust:check:ios": "../scripts/build-and-check-mobile-rust.sh ios",
    "rust:check:android": "../scripts/build-and-check-mobile-rust.sh android",
    "check": "vp check && vp run typecheck",
    "typecheck": "vp exec tsc --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "expo": "^57.0.12",
    "expo-background-task": "~57.0.9",
    "expo-dev-client": "~57.0.11",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-sharing": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.9",
    "lucide-react-native": "1.31.0",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.9.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.11.4"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "babel-plugin-module-resolver": "5.0.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "postcss": "^8.5.23",
    "shell-quote": "1.10.0",
    "uuid": "^11.1.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  }
}
