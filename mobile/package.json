{
  "name": "stereodrome-mobile",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "vp exec expo start --dev-client",
    "android": "vp exec expo run:android",
    "ios": "vp exec expo run:ios",
    "rust:ios": "../scripts/build-mobile-rust.sh ios",
    "rust:android": "../scripts/build-mobile-rust.sh android",
    "rust:mobile": "../scripts/build-mobile-rust.sh all",
    "rust:check": "../scripts/build-and-check-mobile-rust.sh all",
    "rust:check:ios": "../scripts/build-and-check-mobile-rust.sh ios",
    "rust:check:android": "../scripts/build-and-check-mobile-rust.sh android",
    "check": "vp check && vp run typecheck",
    "typecheck": "vp exec tsc --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "expo": "^57.0.7",
    "expo-background-task": "~57.0.5",
    "expo-dev-client": "~57.0.7",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-sharing": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.5",
    "lucide-react-native": "1.23.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "babel-plugin-module-resolver": "5.0.3",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.7",
    "js-yaml": "4.3.0",
    "shell-quote": "1.10.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
