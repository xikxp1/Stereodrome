{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stereodrome",
  "identifier": "dev.xikxp1.stereodrome",
  "build": {
    "beforeDevCommand": "vp dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vp build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Stereodrome",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Ivan Kachalkin",
    "homepage": "https://github.com/xikxp1/Stereodrome",
    "license": "MIT",
    "category": "Music",
    "shortDescription": "Desktop music player for Subsonic-compatible music servers",
    "longDescription": "Stereodrome is a desktop music player for Subsonic-compatible servers with library sync, full-text search, and rich playback controls. It integrates with system media controls and tray workflows, supports local audio caching, and includes gapless playback and crossfade. Advanced audio features include normalization, equalizer, dynamic compression, and binaural processing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "section": "sound",
        "desktopTemplate": "bundle/linux/main.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "bundle/linux/main.desktop.hbs"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENENEVBNkEzOTBBRjBDNjMKUldSakRLK1FvNlpPeld1bWhTU2pjVlNoTDlpMDl4dW5ML25HRkRBUmg3Tkw5NVNqNTVuT3UxaEsK",
      "endpoints": [
        "https://github.com/xikxp1/Stereodrome/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
