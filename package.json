{
  "name": "stereodrome",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "svelte-kit sync && vp check && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:svelte": "svelte-kit sync && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json --watch",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "version:set": "vp node scripts/set-version.mjs",
    "tauri": "vp exec tauri",
    "prepare": "svelte-kit sync && vp config"
  },
  "license": "MIT",
  "dependencies": {
    "@jis3r/icons": "2.7.0",
    "@tanstack/db": "0.6.14",
    "@tanstack/svelte-query": "6.1.36",
    "@tanstack/svelte-virtual": "3.13.31",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-log": "2.8.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-store": "2.4.3",
    "@tauri-apps/plugin-updater": "2.10.1",
    "lucide-svelte": "1.0.1",
    "marked": "18.0.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "7.1.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.1.0",
    "brace-expansion": "5.0.7",
    "daisyui": "5.6.14",
    "eslint-plugin-svelte": "3.20.0",
    "jiti": "2.7.0",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.2",
    "cookie": "^0.7.2",
    "flatted": "^3.4.2",
    "yaml": "^1.10.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
