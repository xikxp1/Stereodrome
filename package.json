{
  "name": "stereodrome",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun --bun vite build",
    "preview": "vite preview",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "bun --bun eslint . --max-warnings 0 --report-unused-disable-directives --report-unused-inline-configs error",
    "lint:fix": "bun --bun eslint . --fix",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "version:set": "bun scripts/set-version.mjs",
    "tauri": "bun node_modules/@tauri-apps/cli/tauri.js"
  },
  "license": "MIT",
  "dependencies": {
    "@jis3r/icons": "2.7.0",
    "@tanstack/db": "0.6.14",
    "@tanstack/svelte-query": "6.1.36",
    "@tanstack/svelte-virtual": "3.13.31",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-log": "2.8.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-store": "2.4.3",
    "@tauri-apps/plugin-updater": "2.10.1",
    "lucide-svelte": "1.0.1",
    "marked": "18.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.69.1",
    "@sveltejs/vite-plugin-svelte": "7.1.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.1.0",
    "brace-expansion": "5.0.7",
    "daisyui": "5.6.14",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.20.0",
    "globals": "17.7.0",
    "jiti": "2.7.0",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.3"
